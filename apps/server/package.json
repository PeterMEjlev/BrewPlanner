{
  "name": "@checklist/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "user": "tsx src/auth/cli.ts",
    "device": "tsx src/devices/cli.ts",
    "notify": "tsx src/notify/cli.ts",
    "seed:demo": "tsx src/devices/seed-demo.ts"
  },
  "dependencies": {
    "@checklist/shared": "*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.0.3",
    "better-sqlite3": "^11.7.0",
    "drizzle-orm": "^0.38.3",
    "fastify": "^5.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
