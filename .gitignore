node_modules/
dist/
*.log

# TypeScript incremental build cache (regenerated by `npm run build`)
*.tsbuildinfo

# SQLite database (per-device; contains live data + the admin password hash)
*.sqlite
# SQLite WAL/lock files (transient, can be inconsistent)
*.sqlite-shm
*.sqlite-wal

# Generated session-signing secret (per-device, never commit)
session-secret

# Local secrets for development (API keys). Production reads
# /etc/brewplanner.env, which lives outside the repo. The *.env.example files
# under deploy/ are templates with empty values and stay tracked.
.env
.env.*
!*.env.example

# Bruce's knowledge index — derived from knowledge/*.md by `npm run knowledge`.
# Tens of MB of float vectors: rebuildable, and far too big to carry in git.
knowledge-index.json
knowledge-index.bin

# Untracked files deploy/update.sh moved aside so a pull could fast-forward.
data/update-backups/

# Editor / OS
.DS_Store
.vscode/
.idea/
