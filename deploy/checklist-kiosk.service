[Unit]
Description=Chromium kiosk for the checklist display
# Wait for the app server to be up, plus a graphical/seat target.
After=checklist-server.service systemd-user-sessions.service
Wants=checklist-server.service

[Service]
Type=simple
User=pi
# Launch Chromium directly on the KMS/DRM display via cage (a minimal Wayland
# kiosk compositor) — no full desktop environment required.
# Install with:  sudo apt install -y cage chromium-browser
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStartPre=/bin/sh -c 'until curl -sf http://localhost:3000/api/active >/dev/null; do sleep 1; done'
ExecStart=/usr/bin/cage -- /usr/bin/chromium-browser \
  --kiosk \
  --noerrdialogs \
  --disable-infobars \
  --disable-translate \
  --disable-features=TranslateUI \
  --check-for-update-interval=31536000 \
  --overscroll-history-navigation=0 \
  --app=http://localhost:3000/display
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
