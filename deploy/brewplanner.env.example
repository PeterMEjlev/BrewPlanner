# BrewPlanner server secrets. Copy to /etc/brewplanner.env on the Pi, fill in
# real values, then: sudo chmod 600 /etc/brewplanner.env
#
# This file is referenced by checklist-server.service (EnvironmentFile=).
# NEVER commit the filled-in version to git.

# Signs session cookies. Use a long random string (>= 32 chars), e.g.:
#   openssl rand -base64 48
# If unset, the server generates and persists one in data/session-secret.
SESSION_SECRET=

# The initial admin account, created on first boot only if no users exist yet.
# After first boot you can rotate it with:  npm run user -- <name> <password>
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Read-only Bearer token for headless clients that can't hold a session cookie
# (e.g. the Garmin watch app). When set, requests with
# `Authorization: Bearer <token>` are allowed through the auth guard with the
# same read access as a logged-in user. Generate with: openssl rand -base64 32
# Leave blank to disable this access path entirely.
WATCH_API_TOKEN=

# Brewer's Friend read-only API key, used to list your recipes so you can pick
# the one currently in the fermenter (sets the beer style on the kiosk card).
# Generate it under Brewer's Friend → Profile → Integrations (requires an
# account with API access). Leave blank to disable the recipe picker.
BREWERS_FRIEND_API_KEY=

# Lets the desktop dashboard edit keg contents (the Pi kiosk keg screen stays
# read-only). The keg inventory is a published, read-only Google Sheet, so writes
# go through a Google Apps Script web app deployed on that sheet. Paste the script
# from apps/server/google-apps-script/keg-updater.gs into the sheet
# (Extensions → Apps Script), deploy it as a Web app (Execute as: Me, Access:
# Anyone), and put the /exec deployment URL here. Leave blank to keep kegs
# read-only everywhere (the editor then reports "not configured").
KEG_SHEET_WRITE_URL=

# Brewery speaker (Sonos / IKEA SYMFONISK) for the kiosk now-playing screen. The
# SYMFONISK runs Sonos firmware, so the server controls it directly over the LAN
# — no Spotify account or OAuth. Both are optional:
#   - SONOS_HOST: the speaker's LAN IP. Most reliable (skips multicast discovery
#     entirely); set this if you have more than one Sonos or discovery is flaky.
#   - SONOS_ROOM: the zone/room name (as shown in the Sonos app, e.g. "Brewery").
#     Used to pick the right speaker when discovering. Ignored if SONOS_HOST is set.
# Leave both blank to auto-discover and use the first Sonos that answers.
# SONOS_HOST=192.168.1.50
# SONOS_ROOM=Brewery

# The brewing rig (the separate brew-system-v3 Pi) for the Brew System page.
# Point this at the rig's FastAPI on the LAN — give that Pi a static IP or DHCP
# reservation first so the address doesn't rot. The rig's API is unauthenticated
# by design (LAN-only); this server proxies it behind login + admin role.
# Leave blank to disable — the Brew System page then shows "not configured".
# BREW_SYSTEM_URL=http://192.168.1.60:8000

# Telegram notifications (keg too old, fermentation complete). Both must be set
# or the notification scheduler stays disabled. Get the token from @BotFather;
# find the chat id by messaging your bot, then `npm run notify -- chat-id`.
# Test delivery from Settings → Notifications, or `npm run notify -- test`.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: how often (seconds) the scheduler checks the conditions.
# NOTIFY_INTERVAL_SECONDS=300

# --- Bruce, the voice assistant (deploy/bruce.service; see deploy/README-bruce.md)
# Both keys are required for Bruce to start; everything else has sane defaults.
# OpenAI API key (Realtime API — speech in, speech out, function calling).
OPENAI_API_KEY=
# Picovoice access key for the offline "Bruce" wake word (console.picovoice.ai).
PICOVOICE_ACCESS_KEY=
# Optional: OpenAI TTS voice (default alloy).
# BRUCE_VOICE=alloy
# Optional: ALSA capture device for the microphone, e.g. plughw:1.
# Find yours with `arecord -l` once the mic is plugged in.
# BRUCE_MIC_DEVICE=plughw:1
