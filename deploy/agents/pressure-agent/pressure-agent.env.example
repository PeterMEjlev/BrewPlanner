# Copy to /etc/pressure-agent.env (chmod 600) and fill in.
# These are read by pressure-agent.service.

# Base URL of the hub on your LAN. The hub Pi's hostname + port.
HUB_URL=http://checklist01.local:3000

# The device key printed once by, on the hub:
#   npm run device -- add "Fermenter 1" pressure_sensor
DEVICE_KEY=bp_replace_me

# Metric name shown on the dashboard. The trailing unit (bar/psi/c/…) is parsed
# for display, so keep the <name>_<unit> shape.
METRIC=pressure_bar

# Seconds between reads.
INTERVAL=30

# Set to 0 once read_pressure() in agent.py talks to your real sensor.
BP_SIMULATE=1
