# Copy to /etc/tilt-agent.env (chmod 600) and fill in.
# These are read by tilt-agent.service.

# Base URL of the hub on your LAN. The hub Pi's hostname + port.
HUB_URL=http://checklist01.local:3000

# The device key printed once by, on the hub:
#   npm run device -- add "Fermenter Tilt" hydrometer
DEVICE_KEY=bp_replace_me

# Seconds between reads. Tilts beacon slowly, so there's no point polling fast.
INTERVAL=60

# Which Tilt to track (its shell colour):
#   red | green | black | purple | orange | blue | yellow | pink
TILT_COLOR=black

# How long to listen for the beacon each read (seconds).
SCAN_SECONDS=15

# Set to 0 once you have a Tilt and a working BLE adapter (pip3 install bleak).
BP_SIMULATE=1
