# Copy to /etc/inkbird-agent.env (chmod 600) and fill in.
# These are read by inkbird-agent.service.

# Base URL of the hub on your LAN. The hub Pi's hostname + port.
HUB_URL=http://checklist01.local:3000

# The device key printed once by, on the hub:
#   npm run device -- add "Fermenter Controller" brew_controller
DEVICE_KEY=bp_replace_me

# Seconds between reads. Keep this gentle (>=30) — the ITC-308-WIFI drops
# frequent pollers with an "Err 914" lock-up.
INTERVAL=30

# --- Inkbird ITC-308-WIFI (Tuya) local connection ---------------------------
# Get these once with the tinytuya wizard (see README step 2). The local key
# never leaves your LAN; treat it like a password.
INKBIRD_DEVICE_ID=replace_me
INKBIRD_IP=192.168.1.50
INKBIRD_LOCAL_KEY=replace_me
# Tuya protocol version; the ITC-308-WIFI is 3.4. Try 3.3 if reads fail.
INKBIRD_VERSION=3.4

# Set to 0 once the four INKBIRD_* values above are filled in with real ones.
BP_SIMULATE=1

# The agent also applies setpoint changes queued from the dashboard (it pulls
# /api/commands, writes the new target to the controller, then acks). Set to 0
# to keep the agent strictly read-only (the dashboard control then does nothing).
BP_ALLOW_SETPOINT_WRITE=1
