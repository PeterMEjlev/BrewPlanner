# Copy to /etc/power-agent.env (chmod 600) and fill in.
# These are read by power-agent.service.

# Base URL of the hub on your LAN. The hub Pi's hostname + port.
HUB_URL=http://checklist01.local:3000

# The device key printed once by, on the hub:
#   npm run device -- add "Brewery Power" power_meter
DEVICE_KEY=bp_replace_me

# Seconds between reads.
INTERVAL=30

# Set to 0 once read_power() in agent.py talks to your real meter.
BP_SIMULATE=1
