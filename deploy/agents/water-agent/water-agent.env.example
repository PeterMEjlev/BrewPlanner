# Copy to /etc/water-agent.env (chmod 600) and fill in.
# These are read by water-agent.service.

# Base URL of the hub on your LAN. The hub Pi's hostname + port.
HUB_URL=http://checklist01.local:3000

# The device key printed once by, on the hub:
#   npm run device -- add "Brewery Water" water_meter
DEVICE_KEY=bp_replace_me

# Seconds between reads.
INTERVAL=30

# Set to 0 once read_water() in agent.py talks to your real sensor.
BP_SIMULATE=1
